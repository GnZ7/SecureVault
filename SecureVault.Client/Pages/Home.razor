@page "/"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Welcome to SecureVault</h3>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    }
                    else if (userInfo != null)
                    {
                        <h4>Hello, @userInfo.Name!</h4>
                        <p>You are successfully authenticated.</p>
                        <div class="d-inline-flex">
                            <p>Your role:</p>
                            @foreach (var claim in userInfo.Claims.Where(c => c.Type == "role" || c.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role"))
                            {
                                <span class="badge text-bg-primary ms-2" style="max-height: fit-content">@claim.Value</span>
                            }
                        </div>
                        <div>
                            <button class="btn btn-danger" @onclick="Logout">Logout</button>
                        </div>
                    }
                    else
                    {
                        <h4>Please log in to access the vault.</h4>
                        <div class="mt-4">
                            <a href="/login" class="btn btn-primary">Login</a>
                            <a href="/register" class="btn btn-secondary">Register</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private UserInfo? userInfo;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync("/userinfo");
            if (response.IsSuccessStatusCode)
            {
                userInfo = await response.Content.ReadFromJsonAsync<UserInfo>();
            }
        }
        catch
        {
            // Not authenticated
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Logout()
    {
        await Http.PostAsync("/logout", null);
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private class UserInfo
    {
        public string Name { get; set; } = string.Empty;
        public List<ClaimInfo> Claims { get; set; } = new();
    }

    private class ClaimInfo
    {
        public string Type { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }
}
