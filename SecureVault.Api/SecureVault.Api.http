@SecureVault.Api_HostAddress = https://localhost:7091
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..tmp-OQdA28kTfIu1Yka4DStbtMvHoz_hHBhBZOsYLg8
@refreshToken = b2b3d166-7e9a-4540-98f7-250e71026a8e


### Register an user without role, should fail.
POST {{SecureVault.Api_HostAddress}}/register
Content-Type: application/json

{
  "userName": "testGuestUser",
  "password": "testGuest@1234"  
}


### Register an user with User role
### Should pass, unless the username is taken.
POST {{SecureVault.Api_HostAddress}}/register
Content-Type: application/json

{
  "userName": "testUser",
  "password": "testUser@1234",
  "role": "User"
}

### Test new User user created.
### Should pass if the above POST request passed.

POST {{SecureVault.Api_HostAddress}}/login
Content-Type: application/json

{
  "userName": "testUser",
  "password": "testUser@1234"
}

### Login as SuperAdmin and generate jwt
POST {{SecureVault.Api_HostAddress}}/login
Content-Type: application/json

{
  "userName": "superadmin",
  "password": "superAdmin123_!!"
}


### Register an admin user.
### Should pass if there's an user with SuperAdmin Role logged in and the username is not taken.
POST {{SecureVault.Api_HostAddress}}/register-admin
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "userName": "testAdminUser",
  "password": "testAdmin@1234",
  "role": "Admin"
}


### Test new Admin user created.
### Should pass if the above POST request passed.
POST {{SecureVault.Api_HostAddress}}/login
Content-Type: application/json

{
  "userName": "testAdminUser",
  "password": "testAdmin@1234"
}


